type ActionResult {
	affectedCount: Int!
}

type Bookmark {
	id: ID!
	url: String!
	title: String!
	faviconPath: String!
	groupId: ID!
	pinned: Boolean!
	clickCount: Int!
	sortOrder: Int!
	createdAt: Instant!
	updatedAt: Instant!
	lastClickedAt: Instant
}

type BookmarkGroup {
	id: ID!
	name: String!
	collapsed: Boolean!
	sortOrder: Int!
	itemCount: Int!
	createdAt: Instant!
	updatedAt: Instant!
}

input BookmarkInput {
	url: String!
	title: String!
	groupId: ID!
	pinned: Boolean!
	sortOrder: Int!
}

type ClipboardItem {
	id: ID!
	text: String!
	"""
	Client id of the sync origin: empty = captured locally on this device, otherwise received from that peer.
	"""
	source: String!
	label: String!
	sensitive: Boolean!
	createdAt: Instant!
}

input ClipboardRecordInput {
	text: String!
	source: String!
	label: String!
	sensitive: Boolean!
}

type ClipboardRecordResult {
	inserted: Boolean!
	item: ClipboardItem!
}

"""
Taggable data domains — the plain-app `DataType` wire enum
(`shared/src/commonMain/kotlin/com/ismartcoding/plain/enums/DataType.kt`).
GraphQL-arg and tag-column domain; `kind()` is the ordinal stored in
the shared library db `type` column.
"""
enum DataType {
	DEFAULT
	AUDIO
	VIDEO
	IMAGE
	SMS
	CONTACT
	NOTE
	FEED_ENTRY
	CALL
	PACKAGE
	FILE
	APP_FILE
	DOC
}

type Feed {
	id: ID!
	name: String!
	url: String!
	fetchContent: Boolean!
	logo: String!
	lastSyncAt: Instant
	lastError: FeedError!
	createdAt: Instant!
	updatedAt: Instant!
}

type FeedEntry {
	id: ID!
	title: String!
	url: String!
	image: String!
	description: String!
	author: String!
	content: String!
	feedId: ID!
	rawId: String!
	read: Boolean!
	publishedAt: Instant!
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
	feed: Feed
}

type FeedEntryCount {
	id: ID!
	count: Int!
}

type FeedError {
	code: String!
	detail: String!
}

type FeedSyncState {
	feedId: ID!
	status: String!
	error: String!
}

type ImageEditorProject {
	id: ID!
	stateB64: String!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
	createdAt: Instant!
	updatedAt: Instant!
}

input ImageEditorProjectInput {
	stateB64: String!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
}

type ImageEditorProjectSummary {
	id: ID!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
	updatedAt: Instant!
}

scalar Instant

scalar Long

type Mutation {
	createNote(input: NoteInput!): Note!
	updateNote(id: ID!, input: NoteInput!): Note!
	saveFeedEntriesToNotes(query: String!): [ID!]!
	trashNotes(query: String!): ActionResult!
	restoreNotes(query: String!): ActionResult!
	deleteNotes(query: String!): ActionResult!
	exportNotes(query: String!): String!
	updateFeedUrl(id: ID!, url: String!): Feed!
	markFeedEntriesRead(query: String!, read: Boolean!): ActionResult!
	syncFeeds(id: ID): Boolean!
	updateFeed(id: ID!, name: String!, fetchContent: Boolean!): Feed!
	createFeed(url: String!, fetchContent: Boolean!): Feed!
	importFeeds(content: String!): Boolean!
	exportFeeds: String!
	deleteFeed(id: ID!): Boolean!
	syncFeedEntryContent(id: ID!): FeedEntry!
	deleteFeedEntries(query: String!): ActionResult!
	createTag(type: DataType!, name: String!): Tag!
	updateTag(id: ID!, name: String!): Tag!
	deleteTag(id: ID!): Boolean!
	addToTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	updateTagRelations(type: DataType!, item: TagRelationStub!, addTagIds: [ID!]!, removeTagIds: [ID!]!): Boolean!
	removeFromTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	recordClipboard(input: ClipboardRecordInput!): ClipboardRecordResult!
	deleteClipboardItems(query: String!): ActionResult!
	deleteClipboardItemsByIds(ids: [ID!]!): ActionResult!
	addBookmarks(urls: [String!]!, groupId: ID!): [Bookmark!]!
	updateBookmark(id: ID!, input: BookmarkInput!): Bookmark!
	deleteBookmarks(ids: [ID!]!): ActionResult!
	recordBookmarkClick(id: ID!): Boolean!
	createBookmarkGroup(name: String!): BookmarkGroup!
	updateBookmarkGroup(id: ID!, name: String!, collapsed: Boolean!, sortOrder: Int!): BookmarkGroup!
	deleteBookmarkGroup(id: ID!): Boolean!
	fetchBookmarkMetadata(id: ID!): Bookmark
	startPomodoro(durationSec: Int!): Boolean!
	pausePomodoro: Boolean!
	stopPomodoro: Boolean!
	configurePomodoroDay(date: String!, dayStart: Instant!): PomodoroToday!
	tickPomodoro: PomodoroTickResult!
	skipPomodoro: PomodoroTickResult!
	adjustPomodoro(durationSec: Int!): PomodoroToday!
	saveImageEditorProject(id: ID!, input: ImageEditorProjectInput!): ImageEditorProject!
	deleteImageEditorProject(id: ID!): Boolean!
	broadcastImageEditorUpdate(id: ID!, update: String!): Boolean!
}

type Note {
	id: ID!
	title: String!
	content: String!
	deletedAt: Instant
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
}

input NoteInput {
	title: String!
	content: String!
}

type PomodoroRecord {
	id: ID!
	"""
	Calendar date (YYYY-MM-DD) in the host device's local timezone.
	"""
	date: String!
	completedCount: Int!
	totalWorkSec: Long!
	totalBreakSec: Long!
	createdAt: Instant!
	updatedAt: Instant!
}

type PomodoroSettings {
	workDurationMin: Int!
	shortBreakDurationMin: Int!
	longBreakDurationMin: Int!
	pomodorosBeforeLongBreak: Int!
	showNotification: Boolean!
	playSoundOnComplete: Boolean!
	soundPath: String!
	originalSoundName: String!
}

enum PomodoroState {
	WORK
	SHORT_BREAK
	LONG_BREAK
}

type PomodoroTickResult {
	today: PomodoroToday!
	completedState: PomodoroState
}

type PomodoroToday {
	date: Instant!
	completedCount: Int!
	currentRound: Int!
	timeLeftSec: Int!
	totalTimeSec: Int!
	isRunning: Boolean!
	isPaused: Boolean!
	state: PomodoroState!
}

type Query {
	noteCount(query: String!): Int!
	note(id: ID!): Note
	notes(offset: Int!, limit: Int!, query: String!): [Note!]!
	feedSyncStates: [FeedSyncState!]!
	feed(id: ID!): Feed
	feeds: [Feed!]!
	feedEntryCounts: [FeedEntryCount!]!
	feedEntryCount(query: String!): Int!
	feedEntry(id: ID!): FeedEntry
	feedEntries(offset: Int!, limit: Int!, query: String!): [FeedEntry!]!
	tags(type: DataType!): [Tag!]!
	tag(id: ID!): Tag
	tagKeys(id: ID!): [String!]!
	tagRelations(type: DataType!, keys: [String!]!): [TagRelation!]!
	clipboardItems(offset: Int!, limit: Int!, query: String!): [ClipboardItem!]!
	clipboardItemCount(query: String!): Int!
	bookmarks: [Bookmark!]!
	bookmarkGroups: [BookmarkGroup!]!
	pomodoroSettings: PomodoroSettings!
	pomodoroToday: PomodoroToday!
	pomodoroRecord(date: String!): PomodoroRecord
	pomodoroRecords(startDate: String!): [PomodoroRecord!]!
	pomodoroTotalCompleted: Long!
	imageEditorProjects: [ImageEditorProjectSummary!]!
	imageEditorProject(id: ID!): ImageEditorProject
	imageEditorProjectItems(offset: Int!, limit: Int!, query: String!): [ImageEditorProjectSummary!]!
}

type Tag {
	id: ID!
	name: String!
	"""
	Numeric tag kind — the ordinal of the tag's `DataType`
	(DEFAULT=0, AUDIO=1, VIDEO=2, IMAGE=3, …). The NAS only has data
	for the media kinds; the Int is frozen phone contract (API_SPEC
	§9), the mapping lives in docs/api/tags.md.
	"""
	type: Int!
	count: Int!
}

"""
One (tag, item-key) relation (plain-app contract). `key` is the media id
/ entity key the tag is attached to.
"""
type TagRelation {
	tagId: ID!
	key: String!
}

input TagRelationStub {
	key: String!
	title: String!
	size: Long!
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
schema {
	query: Query
	mutation: Mutation
}
