enum Action {
	TRASH
	RESTORE
	DELETE
	MOVE
}

type ActionResult {
	affectedCount: Int!
}

type AppFile {
	id: String!
	size: Long!
	mimeType: String!
	realPath: String!
	fileName: String!
	createdAt: Instant!
	updatedAt: Instant!
}

type AppFileRecord {
	fileName: String!
	id: String!
	size: Long!
	mimeType: String!
	realPath: String!
	refCount: Int!
	weakHash: String!
	createdAt: Instant!
	updatedAt: Instant!
}

type AudioArtistPlayCount {
	artist: String!
	count: Long!
}

enum AudioCommand {
	PLAY
	PAUSE
	SEEK
	NEXT
	PREVIOUS
	COMPLETED
	CLEAR
	RESTART
	SET_SPEED
}

type AudioHostSource {
	source: String!
	playlistId: ID!
	currentPath: String!
	currentIndex: Long!
	sortBy: String!
}

input AudioHostTrackInput {
	path: String!
	title: String!
	artist: String!
	albumId: ID!
	durationMs: Long!
}

type AudioItem {
	title: String!
	artist: String!
	"""
	Album id from the platform catalog, null when the track carries no
	album metadata.
	"""
	albumId: ID
	path: String!
	durationMs: Long!
}

type AudioPlayback {
	path: String!
	positionMs: Long!
	revision: Long!
}

type Bookmark {
	id: ID!
	url: String!
	title: String!
	faviconPath: String!
	groupId: ID!
	pinned: Boolean!
	clickCount: Int!
	sortOrder: Int!
	createdAt: Instant!
	updatedAt: Instant!
	lastClickedAt: Instant
}

type BookmarkGroup {
	id: ID!
	name: String!
	collapsed: Boolean!
	sortOrder: Int!
	itemCount: Int!
	createdAt: Instant!
	updatedAt: Instant!
}

input BookmarkInput {
	url: String!
	title: String!
	groupId: ID!
	pinned: Boolean!
	sortOrder: Int!
}

enum ChannelMemberStatus {
	JOINED
	PENDING
}

type ChatChannel {
	id: ID!
	ownerId: ID!
	name: String!
	members: [ChatChannelMember!]!
	"""
	Monotonically increasing mutation counter; receivers ignore channel
	updates whose version is not greater than their local copy.
	"""
	version: Long!
	status: ChatChannelStatus!
	createdAt: Instant!
	updatedAt: Instant!
}

type ChatChannelMember {
	peerId: ID!
	status: ChannelMemberStatus!
}

enum ChatChannelStatus {
	JOINED
	LEFT
	KICKED
}

type ChatConversation {
	id: ID!
	chat: ChatItem!
}

type ChatItem {
	"""
	`me` when this device created the item, otherwise the client id of
	the originating peer.
	"""
	fromId: ID!
	"""
	Peer id for direct messages; empty for channel messages —
	`channelId` is authoritative there.
	"""
	toId: ID!
	"""
	Null for direct messages: the store keeps "" and the contract says
	null, because "" is not a channel a client can query.
	"""
	channelId: ID
	id: ID!
	"""
	Message envelope JSON: `{type: TEXT|IMAGES|FILES|SHARE, value: {…}}` —
	parse `value` according to `type`.
	"""
	content: String!
	createdAt: Instant!
	updatedAt: Instant!
	status: ChatStatus!
	"""
	Per-recipient delivery details as JSON (peer delivery results);
	empty when the message has no delivery failures. Drives
	SENT/PARTIAL/FAILED alongside `status`.
	"""
	statusData: String!
}

enum ChatStatus {
	SENT
	PARTIAL
	FAILED
	PENDING
}

type ChatTextEdit {
	changed: Boolean!
	chat: ChatItem!
}

type ClipboardItem {
	id: ID!
	text: String!
	"""
	Client id of the sync origin: empty = captured locally on this device, otherwise received from that peer.
	"""
	source: String!
	label: String!
	sensitive: Boolean!
	createdAt: Instant!
}

input ClipboardRecordInput {
	text: String!
	source: String!
	label: String!
	sensitive: Boolean!
}

type ClipboardRecordResult {
	inserted: Boolean!
	item: ClipboardItem!
}

"""
Taggable data domains — the plain-app `DataType` wire enum
(`shared/src/commonMain/kotlin/com/ismartcoding/plain/enums/DataType.kt`).
GraphQL-arg and tag-column domain; `kind()` is the ordinal stored in
the shared library db `type` column.
"""
enum DataType {
	DEFAULT
	AUDIO
	VIDEO
	IMAGE
	SMS
	CONTACT
	NOTE
	FEED_ENTRY
	CALL
	PACKAGE
	FILE
	APP_FILE
	DOC
}

type FavoriteFolder {
	rootPath: String!
	fullPath: String!
	alias: String
}

type Feed {
	id: ID!
	name: String!
	url: String!
	fetchContent: Boolean!
	logo: String!
	lastSyncAt: Instant
	lastError: FeedError!
	createdAt: Instant!
	updatedAt: Instant!
}

type FeedEntry {
	id: ID!
	title: String!
	url: String!
	image: String!
	description: String!
	author: String!
	content: String!
	feedId: ID!
	rawId: String!
	read: Boolean!
	publishedAt: Instant!
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
	feed: Feed
}

type FeedEntryCount {
	id: ID!
	count: Int!
}

type FeedError {
	code: String!
	detail: String!
}

type FeedSyncState {
	feedId: ID!
	status: String!
	error: String!
}

type FileHostCompletedOp {
	src: String!
	dst: String!
}

type FileHostTask {
	id: ID!
	clientId: String!
	type: FileTaskType!
	title: String!
	status: FileTaskStatus!
	error: String!
	totalBytes: Long!
	doneBytes: Long!
	totalItems: Long!
	doneItems: Long!
	createdAt: Instant!
	updatedAt: Instant!
	completedOps: [FileHostCompletedOp!]!
}

input FileHostTaskOpInput {
	src: String!
	dst: String!
	overwrite: Boolean!
}

enum FileTaskStatus {
	QUEUED
	RUNNING
	DONE
	ERROR
}

enum FileTaskType {
	COPY
	MOVE
}

type ImageEditorProject {
	id: ID!
	stateB64: String!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
	createdAt: Instant!
	updatedAt: Instant!
}

input ImageEditorProjectInput {
	stateB64: String!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
}

type ImageEditorProjectSummary {
	id: ID!
	thumbnail: String
	canvasWidth: Int!
	canvasHeight: Int!
	layerCount: Int!
	updatedAt: Instant!
}

input ImageHostEmbeddingInput {
	id: ID!
	path: String!
	embeddingBase64: String!
}

type ImageHostIndexStatus {
	version: Long!
	isRunning: Boolean!
	totalImages: Long!
	indexedImages: Long!
	skippedImages: Long!
	errorMessage: String!
}

type ImageHostSearchResult {
	imageId: ID!
	score: Float!
}

scalar Instant

"""
A scalar that can represent any JSON value.
"""
scalar JSON

scalar Long

type MediaHostActionResult {
	affectedCount: Int!
	failedIds: [ID!]!
}

type MediaHostDuration {
	type: DataType!
	mediaId: ID!
	durationMs: Long!
	updatedAt: Instant!
}

type Mutation {
	startMediaScan(root: String!): Boolean!
	pauseMediaScan: Boolean!
	resumeMediaScan: Boolean!
	stopMediaScan: Boolean!
	setMediaSourceDirs(dirs: [String!]!): Boolean!
	startDiscovery: [NearbyDevice!]!
	stopDiscovery: Boolean!
	"""
	Send a chat message. `target` is the chat target id — a bare peer id
	(an optional `peer:` prefix is accepted), or a `channel:<id>`
	prefixed channel id; same value space as the `chatItems` query.
	`content` is the message envelope JSON, same shape as
	`ChatItem.content`.
	"""
	sendChatItem(target: String!, content: String!): [ChatItem!]!
	"""
	Always true: an id that is already gone is the state the caller asked
	for, and the contract has no way to say "nothing was there".
	"""
	deleteChatItem(id: ID!): Boolean!
	deleteChatItems(query: String!): ActionResult!
	retryChatItem(id: ID!): ChatItem!
	createChatChannel(name: String!): ChatChannel!
	updateChatChannel(id: ID!, name: String!): ChatChannel!
	deleteChatChannel(id: ID!): Boolean!
	leaveChatChannel(id: ID!): Boolean!
	addChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	removeChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	acceptChatChannelInvite(id: ID!): Boolean!
	declineChatChannelInvite(id: ID!): Boolean!
	sendChatText(target: String!, text: String!): ChatItem!
	forwardChatItem(id: ID!, target: String!): ChatItem!
	deliverChatItem(id: ID!, recipients: [ID!]): ChatItem!
	createChatItem(target: String!, content: String!): ChatItem!
	replaceChatFiles(id: ID!, content: String!): ChatItem
	clearChatItems(target: String!): ActionResult!
	editChatText(id: ID!, text: String!): ChatTextEdit!
	setSystemPref(key: String!, value: JSON!): ActionResult!
	removeSystemPref(key: String!): ActionResult!
	updateSystemSettings(input: SystemSettingsInput!): SettingsUpdate!
	updateUserSettings(input: UserSettingsInput!): SettingsUpdate!
	recordRecentSearch(query: String!): ActionResult!
	removeRecentSearch(query: String!): ActionResult!
	clearRecentSearches: ActionResult!
	recordRecentSaveDirectory(path: String!): ActionResult!
	toggleNotificationApp(packageName: String!): ActionResult!
	setNotificationFilterMode(mode: String!): ActionResult!
	clearNotificationFilterApps: ActionResult!
	deletePlaylistVideos(paths: [String!]!): ActionResult!
	removeFileHostTask(clientId: String!, id: ID!): Boolean!
	createFileHostTask(clientId: String!, type: FileTaskType!, title: String!, ops: [FileHostTaskOpInput!]!): FileHostTask!
	audioHostEnqueue(items: [AudioHostTrackInput!]!, playNext: Boolean!): Boolean!
	audioHostRemoveQueued(path: String!): Boolean!
	audioHostReorder(paths: [String!]!): Boolean!
	audioHostMoveQueued(from: Int!, to: Int!): Boolean!
	audioHostClear: Boolean!
	audioHostRemovePaths(paths: [String!]!): Boolean!
	audioHostSetCurrent(path: String!): Boolean!
	audioHostOnPlaying(path: String!, title: String!, artist: String!, durationMs: Long!): Boolean!
	audioHostSetPlaylistSource(id: ID!, startPath: String): AudioItem
	audioHostSetLibrarySource(startPath: String, shuffle: Boolean!, sortBy: String!): AudioItem
	audioHostResolveNext(isNext: Boolean!, shuffle: Boolean!): AudioItem
	audioHostAddPlaylistItems(id: ID!, items: [AudioHostTrackInput!]!): Int!
	audioHostRemovePlaylistItems(id: ID!, paths: [String!]!): Boolean!
	audioHostRecordHistory(path: String!, title: String!, artist: String!, durationMs: Long!): Boolean!
	audioReportStarted(track: AudioHostTrackInput!, revision: Long!): Boolean!
	audioReportProgress(path: String!, revision: Long!, positionMs: Long!): Boolean!
	audioInvalidateEngine: AudioPlayback!
	audioCommand(action: AudioCommand!, positionMs: Long!, speed: Float!): AudioPlayback!
	audioPlayTrack(track: AudioHostTrackInput!, enqueue: Boolean!): AudioPlayback!
	audioPlayPath(path: String!): AudioPlayback!
	saveVideoPlayProgress(mediaId: ID!, positionMs: Long!): VideoPlayProgress!
	deleteVideoPlayProgress(mediaId: ID!): Boolean!
	createShare(name: String!, realPaths: [String!]!, readOnly: Boolean!, expiresAt: Instant): ShareRecord!
	updateShare(id: ID!, name: String!, expiresAt: Instant, realPaths: [String!]): ShareRecord!
	deleteShare(id: ID!): Boolean!
	importAppFile(source: String!, fileName: String!, mimeType: String!, deleteSource: Boolean!): AppFileRecord!
	releaseAppFile(id: String!): Boolean!
	"""
	Register a favorite folder and return the whole list.
	"""
	addFavoriteFolder(rootPath: String!, fullPath: String!): [FavoriteFolder!]!
	"""
	Remove the favorite folder identified by `fullPath` and return the
	whole list.
	"""
	removeFavoriteFolder(fullPath: String!): [FavoriteFolder!]!
	"""
	Set the favorite folder's display alias and return the whole list.
	"""
	setFavoriteFolderAlias(fullPath: String!, alias: String!): [FavoriteFolder!]!
	createNote(input: NoteInput!): Note!
	updateNote(id: ID!, input: NoteInput!): Note!
	saveFeedEntriesToNotes(query: String!): [ID!]!
	trashNotes(query: String!): ActionResult!
	restoreNotes(query: String!): ActionResult!
	deleteNotes(query: String!): ActionResult!
	exportNotes(query: String!): String!
	updateFeedUrl(id: ID!, url: String!): Feed!
	markFeedEntriesRead(query: String!, read: Boolean!): ActionResult!
	syncFeeds(id: ID): Boolean!
	updateFeed(id: ID!, name: String!, fetchContent: Boolean!): Feed!
	createFeed(url: String!, fetchContent: Boolean!): Feed!
	importFeeds(content: String!): Boolean!
	exportFeeds: String!
	deleteFeed(id: ID!): Boolean!
	syncFeedEntryContent(id: ID!): FeedEntry!
	deleteFeedEntries(query: String!): ActionResult!
	createTag(type: DataType!, name: String!): Tag!
	updateTag(id: ID!, name: String!): Tag!
	deleteTag(id: ID!): Boolean!
	addToTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	updateTagRelations(type: DataType!, item: TagRelationStub!, addTagIds: [ID!]!, removeTagIds: [ID!]!): Boolean!
	removeFromTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	tagHostAdd(items: [TagHostRelationInput!]!): Boolean!
	tagHostEdit(type: DataType!, item: TagHostItemInput!, addTagIds: [ID!]!, removeTagIds: [ID!]!): Boolean!
	tagHostRemove(keys: [String!]!, tagIds: [ID!]!): Boolean!
	tagHostRemoveKeys(type: DataType!, keys: [String!]!): Boolean!
	tagHostClearType(type: DataType!): Boolean!
	tagHostClearTag(id: ID!): Boolean!
	mediaHostSaveDuration(type: DataType!, mediaId: ID!, durationMs: Long!): Boolean!
	mediaHostRemoveDurations(type: DataType!, mediaIds: [ID!]!): Long!
	imageHostSaveEmbeddings(items: [ImageHostEmbeddingInput!]!): Boolean!
	imageHostRemoveEmbeddings(ids: [ID!]!): Long!
	imageHostClearEmbeddings: Long!
	mediaHostAction(type: DataType!, action: Action!, ids: [ID!]!, fromTrash: Boolean!, destDir: String!): MediaHostActionResult!
	imageHostStartIndex(force: Boolean!): ImageHostIndexStatus!
	imageHostIndexSelected(ids: [ID!]!): ImageHostIndexStatus!
	imageHostCancelIndex: ImageHostIndexStatus!
	"""
	Write text into the system clipboard on behalf of the calling client.
	The write is recorded with the caller as source; the local watcher
	sees it but skips re-broadcasting (hash dedup), so there is no loop.
	"""
	setClipboard(text: String!): Boolean!
	"""
	Delete clipboard history entries matching the query DSL (`ids:` /
	`text:`; a bare word is a text LIKE). A blank query is rejected —
	send `all:true` to target everything.
	"""
	deleteClipboardItems(query: String!): ActionResult!
	recordClipboard(input: ClipboardRecordInput!): ClipboardRecordResult!
	deleteClipboardItemsByIds(ids: [ID!]!): ActionResult!
	addBookmarks(urls: [String!]!, groupId: ID!): [Bookmark!]!
	updateBookmark(id: ID!, input: BookmarkInput!): Bookmark!
	deleteBookmarks(ids: [ID!]!): ActionResult!
	recordBookmarkClick(id: ID!): Boolean!
	createBookmarkGroup(name: String!): BookmarkGroup!
	updateBookmarkGroup(id: ID!, name: String!, collapsed: Boolean!, sortOrder: Int!): BookmarkGroup!
	deleteBookmarkGroup(id: ID!): Boolean!
	fetchBookmarkMetadata(id: ID!): Bookmark
	startPomodoro(durationSec: Int!): Boolean!
	pausePomodoro: Boolean!
	stopPomodoro: Boolean!
	configurePomodoroDay(date: String!, dayStart: Instant!): PomodoroToday!
	tickPomodoro: PomodoroTickResult!
	skipPomodoro: PomodoroTickResult!
	adjustPomodoro(durationSec: Int!): PomodoroToday!
	saveImageEditorProject(id: ID!, input: ImageEditorProjectInput!): ImageEditorProject!
	deleteImageEditorProject(id: ID!): Boolean!
	broadcastImageEditorUpdate(id: ID!, update: String!): Boolean!
}

type NearbyDevice {
	id: String!
	name: String!
	ips: [String!]!
	port: Int!
	deviceType: String!
	version: String!
	platform: String!
	lastSeen: String!
	discoveryMethods: [String!]!
	bestIp: String!
	status: String!
}

type Note {
	id: ID!
	title: String!
	content: String!
	deletedAt: Instant
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
}

input NoteInput {
	title: String!
	content: String!
}

type PomodoroRecord {
	id: ID!
	"""
	Calendar date (YYYY-MM-DD) in the host device's local timezone.
	"""
	date: String!
	completedCount: Int!
	totalWorkSec: Long!
	totalBreakSec: Long!
	createdAt: Instant!
	updatedAt: Instant!
}

type PomodoroSettings {
	workDurationMin: Int!
	shortBreakDurationMin: Int!
	longBreakDurationMin: Int!
	pomodorosBeforeLongBreak: Int!
	showNotification: Boolean!
	playSoundOnComplete: Boolean!
	soundPath: String!
	originalSoundName: String!
}

enum PomodoroState {
	WORK
	SHORT_BREAK
	LONG_BREAK
}

type PomodoroTickResult {
	today: PomodoroToday!
	completedState: PomodoroState
}

type PomodoroToday {
	date: Instant!
	completedCount: Int!
	currentRound: Int!
	timeLeftSec: Int!
	totalTimeSec: Int!
	isRunning: Boolean!
	isPaused: Boolean!
	state: PomodoroState!
}

type Query {
	scanProgress: ScanProgress!
	mediaSourceDirs: [String!]!
	nearbyDevices: [NearbyDevice!]!
	"""
	Whether the manual discovery scan loop is running. The nearby page
	polls this and restarts the scan when another client stopped it.
	"""
	isDiscovering: Boolean!
	"""
	Latest-first page of one conversation, returned oldest-to-newest so
	clients can render directly. `target` is the chat target id: a bare
	peer id (an optional `peer:` prefix is accepted), or a
	`channel:<id>` prefixed channel id.
	"""
	chatItems(target: String!, query: String!, offset: Int!, limit: Int!): [ChatItem!]!
	"""
	The most recent item of every conversation (direct and channel),
	newest conversation first.
	"""
	latestChatItems: [ChatItem!]!
	chatChannels: [ChatChannel!]!
	chatItem(id: ID!): ChatItem
	chatConversations: [ChatConversation!]!
	chatRecords(query: String!, offset: Int!, limit: Int!): [ChatItem!]!
	chatCount(query: String!): Int!
	chatIds(query: String!): [ID!]!
	userPrefs: JSON!
	systemPrefs: JSON!
	systemSettings: SystemSettings!
	userSettings: UserSettings!
	verifyAdbToken(token: String!): Boolean!
	fileHostTaskRecord(clientId: String!, id: ID!): FileHostTask
	fileHostTasks(clientId: String!, query: String!, offset: Int!, limit: Int!): [FileHostTask!]!
	audioSource: AudioHostSource!
	audioQueuedPaths: [String!]!
	audioArtistPlayCounts: [AudioArtistPlayCount!]!
	audioPlayback: AudioPlayback!
	videoPlayProgress(mediaId: ID!): VideoPlayProgress
	recentVideoPlayProgress(since: Instant!): [VideoPlayProgress!]!
	browseShare(id: ID!, virtualPath: String!): ShareListing!
	shareZipEntries(id: ID!, fileId: String!): [Root!]!
	shareRecord(id: ID!): ShareRecord
	shareRecords: [ShareRecord!]!
	shareToken(id: ID!): String!
	shareAuth(id: ID!): ShareAuthRecord
	resolveSharePath(id: ID!, virtualPath: String!): String
	resolveShareFile(id: ID!, fileId: String!): String
	appFiles(query: String!, offset: Int!, limit: Int!): [AppFile!]!
	appFileCount(query: String!): Int!
	"""
	List all favorite folders.
	"""
	favoriteFolders: [FavoriteFolder!]!
	appFileRecord(id: String!): AppFileRecord
	appFileRecords(query: String!, offset: Int!, limit: Int!): [AppFileRecord!]!
	resolveAppFile(id: String!): String!
	noteCount(query: String!): Int!
	note(id: ID!): Note
	notes(query: String!, offset: Int!, limit: Int!): [Note!]!
	feedSyncStates: [FeedSyncState!]!
	feed(id: ID!): Feed
	feeds: [Feed!]!
	feedEntryCounts: [FeedEntryCount!]!
	feedEntryCount(query: String!): Int!
	feedEntry(id: ID!): FeedEntry
	feedEntries(query: String!, offset: Int!, limit: Int!): [FeedEntry!]!
	tags(type: DataType!): [Tag!]!
	tag(id: ID!): Tag
	tagKeys(id: ID!): [String!]!
	tagRelations(type: DataType!, keys: [String!]!): [TagRelation!]!
	tagHostAll(type: DataType!): [TagHostRecord!]!
	tagHostGet(id: ID!): TagHostRecord
	tagHostRelations(type: DataType!, keys: [String!]!): [TagHostRelation!]!
	tagHostIntersection(tagIds: [ID!]!): [String!]!
	mediaHostDurations: [MediaHostDuration!]!
	imageHostEmbeddingIds: [ID!]!
	imageHostEmbeddingCount: Long!
	imageHostSearch(embeddingBase64: String!, maxResults: Int!): [ImageHostSearchResult!]!
	imageHostIndexStatus: ImageHostIndexStatus!
	"""
	Paged clipboard history, newest first.
	"""
	clipboardItems(query: String!, offset: Int!, limit: Int!): [ClipboardItem!]!
	clipboardItemCount(query: String!): Int!
	bookmarks: [Bookmark!]!
	bookmarkGroups: [BookmarkGroup!]!
	pomodoroSettings: PomodoroSettings!
	pomodoroToday: PomodoroToday!
	pomodoroRecord(date: String!): PomodoroRecord
	pomodoroRecords(startDate: String!): [PomodoroRecord!]!
	pomodoroTotalCompleted: Long!
	imageEditorProjects: [ImageEditorProjectSummary!]!
	imageEditorProject(id: ID!): ImageEditorProject
	imageEditorProjectItems(query: String!, offset: Int!, limit: Int!): [ImageEditorProjectSummary!]!
}

type Root {
	virtualPath: String!
	realPath: String!
	isDir: Boolean!
}

type ScanProgress {
	indexed: Int!
	pending: Int
	total: Int
	state: ScanState!
	error: String
}

"""
Media-index scan lifecycle, shared by `scanProgress.state` and the
`media:scan:progress` WS payload (same values on both wires).
"""
enum ScanState {
	IDLE
	RUNNING
	PAUSED
	STOPPED
	FAILED
}

type SettingsUpdate {
	result: ActionResult!
	systemSettings: SystemSettings!
	userSettings: UserSettings!
}

type ShareAuthRecord {
	share: ShareRecord!
	token: String!
}

type ShareListing {
	share: ShareRecord!
	entries: [Root!]!
}

type ShareRecord {
	id: ID!
	name: String!
	password: String!
	urlToken: String!
	readOnly: Boolean!
	expiresAt: Instant
	createdAt: Instant!
	updatedAt: Instant!
	roots: [Root!]!
}

type SystemSettings {
	password: String!
	passwordType: Int!
	authTwoFactor: Boolean!
	rotateUrlTokenOnRestart: Boolean!
	adbToken: String!
	updateInfo: JSON!
	urlToken: String!
	apiPermissions: [String!]!
	onboardingCompleted: Boolean!
	clientId: ID!
	mdnsHostname: String!
	signaturePublicKey: String!
}

enum SystemSettingsAction {
	SET_PASSWORD
	SET_PASSWORD_TYPE
	SET_TWO_FACTOR
	SET_ROTATE_URL_TOKEN
	RESET_PASSWORD
	RESET_URL_TOKEN
	RESET_ADB_TOKEN
	SET_API_PERMISSION
	SET_API_PERMISSIONS
	COMPLETE_ONBOARDING
	SET_MDNS_HOSTNAME
	PATCH_UPDATE
}

"""
The action selects a command; only its required arguments may be supplied.
PATCH_UPDATE changes supplied fields and leaves omitted fields untouched.
"""
input SystemSettingsInput {
	action: SystemSettingsAction!
	password: String
	value: Int
	enabled: Boolean
	permission: String
	permissions: [String!]
	hostname: String
	patch: JSON
}

type Tag {
	id: ID!
	name: String!
	"""
	Numeric tag kind — the ordinal of the tag's `DataType`
	(DEFAULT=0, AUDIO=1, VIDEO=2, IMAGE=3, …). The NAS only has data
	for the media kinds; the Int is frozen phone contract.
	"""
	type: Int!
	count: Int!
}

input TagHostItemInput {
	key: String!
	sizeBytes: Long!
	title: String!
}

type TagHostRecord {
	id: ID!
	name: String!
	type: Int!
	count: Int!
	createdAt: Instant!
	updatedAt: Instant!
}

type TagHostRelation {
	tagId: ID!
	key: String!
	type: Int!
	createdAt: Instant!
	sizeBytes: Long!
	title: String!
}

input TagHostRelationInput {
	tagId: ID!
	key: String!
	type: DataType!
	sizeBytes: Long!
	title: String!
}

"""
One (tag, item-key) relation (plain-app contract). `key` is the media id
/ entity key the tag is attached to.
"""
type TagRelation {
	tagId: ID!
	key: String!
}

input TagRelationStub {
	key: String!
	title: String!
	size: Long!
}

