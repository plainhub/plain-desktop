type ActionResult {
	affectedCount: Int!
}

type Call {
	id: ID!
	number: String!
	name: String!
	photoId: String!
	startedAt: Instant!
	durationSec: Int!
	type: CallType!
	accountId: ID!
	geo: PhoneGeo
	tags: [Tag!]!
}

enum CallType {
	INCOMING
	OUTGOING
	MISSED
	VOICEMAIL
	REJECTED
	BLOCKED
	ANSWERED_EXTERNALLY
	UNKNOWN
}

type Certificate {
	issuer: String!
	subject: String!
	serialNumber: String!
	validFrom: Instant!
	validTo: Instant!
}

type ClipboardItem {
	id: ID!
	text: String!
	"""
	Client id of the sync origin: empty = captured locally on this device, otherwise received from that peer.
	"""
	source: String!
	label: String!
	sensitive: Boolean!
	createdAt: Instant!
}

type Contact {
	id: ID!
	prefix: String!
	firstName: String!
	middleName: String!
	lastName: String!
	suffix: String!
	nickname: String!
	photoId: String!
	phoneNumbers: [ContactPhoneNumber!]!
	emails: [ContactEmail!]!
	addresses: [ContactAddress!]!
	events: [ContactEvent!]!
	source: String!
	starred: Boolean!
	contactId: ID!
	thumbnailId: String!
	notes: String!
	groups: [ContactGroup!]!
	organization: Organization
	websites: [ContactWebsite!]!
	ims: [ContactIm!]!
	ringtone: String!
	updatedAt: Instant!
	tags: [Tag!]!
}

type ContactAddress {
	value: String!
	type: PostalType!
	label: String!
}

input ContactAddressInput {
	value: String!
	type: PostalType!
	label: String!
}

type ContactEmail {
	value: String!
	type: EmailType!
	label: String!
}

input ContactEmailInput {
	value: String!
	type: EmailType!
	label: String!
}

type ContactEvent {
	value: String!
	type: EventType!
	label: String!
}

input ContactEventInput {
	value: String!
	type: EventType!
	label: String!
}

type ContactGroup {
	id: ID!
	name: String!
	contactCount: Int!
}

type ContactIm {
	value: String!
	protocol: ImProtocol!
	customProtocol: String!
}

input ContactImInput {
	value: String!
	protocol: ImProtocol!
	customProtocol: String!
}

input ContactInput {
	prefix: String!
	firstName: String!
	middleName: String!
	lastName: String!
	suffix: String!
	nickname: String!
	phoneNumbers: [ContactPhoneInput!]!
	emails: [ContactEmailInput!]!
	addresses: [ContactAddressInput!]!
	events: [ContactEventInput!]!
	source: String!
	starred: Boolean!
	notes: String!
	groupIds: [ID!]!
	organization: OrganizationInput
	websites: [ContactWebsiteInput!]!
	ims: [ContactImInput!]!
}

input ContactPhoneInput {
	value: String!
	type: PhoneType!
	label: String!
}

type ContactPhoneNumber {
	value: String!
	type: PhoneType!
	label: String!
	normalizedNumber: String!
}

type ContactSource {
	name: String!
	type: String!
}

type ContactWebsite {
	value: String!
	type: WebsiteType!
	label: String!
}

input ContactWebsiteInput {
	value: String!
	type: WebsiteType!
	label: String!
}

enum EmailType {
	CUSTOM
	HOME
	WORK
	OTHER
	MOBILE
}

enum EventType {
	CUSTOM
	ANNIVERSARY
	BIRTHDAY
	OTHER
}

enum FileSortBy {
	DATE_ASC
	DATE_DESC
	SIZE_ASC
	SIZE_DESC
	NAME_ASC
	NAME_DESC
	TAKEN_AT_DESC
}

enum ImProtocol {
	CUSTOM
	AIM
	MSN
	YAHOO
	SKYPE
	QQ
	GOOGLE_TALK
	ICQ
	JABBER
	NETMEETING
}

type ImageSearchStatus {
	status: ImageSearchStatusType!
	downloadProgress: Int!
	errorMessage: String!
	modelSize: Long!
	modelDir: String!
	isIndexing: Boolean!
	totalImages: Int!
	indexedImages: Int!
}

enum ImageSearchStatusType {
	UNAVAILABLE
	DOWNLOADING
	LOADING
	READY
	ERROR
}

scalar Instant

scalar Long

type Mutation {
	uninstallPackages(ids: [ID!]!): Boolean!
	"""
	Bundle unpacking is heavy disk I/O, so the platform side keeps it off
	the engine thread; a failure surfaces as `Installation failed: …`.
	"""
	installPackage(path: String!): PackageInstallPending!
	deleteNotifications(ids: [ID!]!): ActionResult!
	"""
	`actionIndex` indexes [`Notification::reply_actions`], the
	reply-capable subset — not the plain action list.
	"""
	replyNotification(id: ID!, actionIndex: Int!, text: String!): Boolean!
	"""
	Write text into the system clipboard on behalf of the calling client.
	The write is recorded with the caller as source; the local watcher
	sees it but skips re-broadcasting (hash dedup), so there is no loop.
	"""
	setClipboard(text: String!): Boolean!
	"""
	Delete clipboard history entries matching the query DSL (`ids:` /
	`text:`; a bare word is a text LIKE). A blank query is rejected —
	send `all:true` to target everything (API_SPEC §5).
	"""
	deleteClipboardItems(query: String!): ActionResult!
	createContact(input: ContactInput!): Contact!
	updateContact(id: ID!, input: ContactInput!): Contact!
	deleteContacts(query: String!): ActionResult!
	createContactGroup(name: String!, accountName: String!, accountType: String!): ContactGroup!
	updateContactGroup(id: ID!, name: String!): ContactGroup!
	deleteContactGroup(id: ID!): Boolean!
	archiveSmsConversation(id: ID!): Boolean!
	unarchiveSmsConversation(id: ID!): Boolean!
	trashSms(query: String!): ActionResult!
	restoreSms(query: String!): ActionResult!
	deleteSms(query: String!): ActionResult!
	"""
	`subscriptionId` picks the SIM (-1 = system default, see `sims`);
	`requestId` is an optional idempotency key that dedupes retried sends.
	"""
	sendSms(number: String!, body: String!, subscriptionId: Int!, requestId: String): Boolean!
	"""
	Compose an MMS in the device's default SMS app and track the send.
	Returns a pendingId consumed by the MMS polling flow.
	"""
	sendMms(number: String!, body: String!, attachmentPaths: [String!]!, threadId: ID!): String!
	deleteCalls(query: String!): ActionResult!
	"""
	`showDialer` hands the number to the dialer instead of placing the
	call outright.
	"""
	call(number: String!, showDialer: Boolean!): Boolean!
	startScreenMirror(audio: Boolean!): Boolean!
	stopScreenMirror: Boolean!
	"""
	Returns false when the device has not granted RECORD_AUDIO yet; the
	platform asks for it and the caller retries.
	"""
	requestScreenMirrorAudio: Boolean!
	requestScreenMirrorKeyFrame: Boolean!
	updateScreenMirrorQuality(mode: ScreenMirrorMode!): Boolean!
	enableImageSearch: Boolean!
	disableImageSearch: Boolean!
	cancelImageModelDownload: Boolean!
	"""
	`force` re-scans images that already have an embedding.
	"""
	startImageIndex(force: Boolean): Boolean!
	cancelImageIndex: Boolean!
	openAccessibilitySettings: Boolean!
	openWebSettings(feature: WebSettingsFeature): Boolean!
}

type Notification {
	id: ID!
	"""
	Android FLAG_ONLY_ALERT_ONCE: re-posted updates must not sound/vibrate again.
	"""
	onlyOnce: Boolean!
	isClearable: Boolean!
	appId: ID!
	appName: String!
	postedAt: Instant!
	silent: Boolean!
	title: String!
	body: String!
	actions: [String!]!
	"""
	Subset of `actions` that support inline reply; `replyNotification`'s
	`actionIndex` indexes this list, not `actions`.
	"""
	replyActions: [String!]!
}

type Organization {
	company: String!
	title: String!
}

input OrganizationInput {
	company: String!
	title: String!
}

type Package {
	id: ID!
	name: String!
	type: PackageType!
	version: String!
	path: String!
	size: Long!
	certs: [Certificate!]!
	installedAt: Instant!
	updatedAt: Instant!
}

type PackageInstallPending {
	id: ID!
	updatedAt: Instant
	isNew: Boolean!
}

type PackageStatus {
	id: ID!
	exists: Boolean!
	updatedAt: Instant
}

enum PackageType {
	SYSTEM
	"""
	Anything the platform did not report as a pre-installed package.
	Misclassifying a user app as system would hide it from uninstall.
	"""
	USER
}

type PhoneGeo {
	country: String!
	numberType: String!
	carrier: String!
	description: String!
}

enum PhoneType {
	CUSTOM
	HOME
	MOBILE
	WORK
	FAX_WORK
	FAX_HOME
	PAGER
	OTHER
	CALLBACK
	CAR
	COMPANY_MAIN
	ISDN
	MAIN
	OTHER_FAX
	RADIO
	TELEX
	TTY_DDD
	WORK_MOBILE
	WORK_PAGER
	ASSISTANT
}

enum PostalType {
	CUSTOM
	HOME
	WORK
	OTHER
}

type Query {
	packages(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Package!]!
	packageCount(query: String!): Int!
	packageStatuses(ids: [ID!]!): [PackageStatus!]!
	notifications(offset: Int!, limit: Int!, query: String!): [Notification!]!
	notificationCount(query: String!): Int!
	"""
	Paged clipboard history, newest first.
	"""
	clipboardItems(offset: Int!, limit: Int!, query: String!): [ClipboardItem!]!
	clipboardItemCount(query: String!): Int!
	contacts(offset: Int!, limit: Int!, query: String!): [Contact!]!
	"""
	plain-app degrades this to 0 rather than erroring when the web client
	was not granted the contact permission.
	"""
	contactCount(query: String!): Int!
	contactSources: [ContactSource!]!
	contactGroups: [ContactGroup!]!
	sms(offset: Int!, limit: Int!, query: String!): [Sms!]!
	smsCount(query: String!): Int!
	smsBoxCounts: SmsCounts!
	smsConversations(offset: Int!, limit: Int!, query: String!): [SmsConversation!]!
	smsConversationCount(query: String!): Int!
	archivedSmsConversations(offset: Int!, limit: Int!, query: String!): [SmsConversation!]!
	calls(offset: Int!, limit: Int!, query: String!): [Call!]!
	"""
	plain-app degrades this to 0 rather than erroring.
	"""
	callCount(query: String!): Int!
	isScreenMirroring: Boolean!
	screenMirrorControlEnabled: Boolean!
	"""
	Null while the pipeline has not published its codec configuration.
	"""
	screenMirrorVideoCodec: ScreenMirrorVideoCodec
	screenMirrorQuality: ScreenMirrorQuality!
	imageSearchStatus: ImageSearchStatus!
}

enum ScreenMirrorMode {
	HD
	SMOOTH
}

type ScreenMirrorQuality {
	mode: ScreenMirrorMode!
	resolution: Int!
}

type ScreenMirrorVideoCodec {
	"""
	H.264 Annex-B codec configuration (SPS/PPS), base64-encoded.
	"""
	annexB: String!
	"""
	Latest H.264 keyframe, base64-encoded; null until the pipeline emits one.
	"""
	keyFrame: String
}

type Sms {
	id: ID!
	body: String!
	address: String!
	sentAt: Instant!
	serviceCenter: String!
	read: Boolean!
	threadId: ID!
	type: SmsType!
	subscriptionId: Int!
	isMms: Boolean!
	attachments: [SmsAttachment!]!
	tags: [Tag!]!
}

type SmsAttachment {
	path: String!
	contentType: String!
	name: String!
}

type SmsConversation {
	id: ID!
	address: String!
	snippet: String!
	lastMessageAt: Instant!
	messageCount: Int!
	read: Boolean!
	addresses: [String!]!
}

type SmsCounts {
	total: Int!
	inbox: Int!
	sent: Int!
	drafts: Int!
}

enum SmsType {
	INBOX
	SENT
	DRAFT
	OUTBOX
	FAILED
	QUEUED
	UNKNOWN
}

"""
The contract's `Tag` carries no numeric kind — that lives in the
`tags(type:)` filter instead — so it is not `content_types::Tag`.
"""
type Tag {
	id: ID!
	name: String!
	count: Int!
}

enum WebSettingsFeature {
	FILES
	CONTACTS
	SMS
	CALL_LOGS
	CALL_PHONE
	PHONE_NUMBER
	APPS
	NOTIFICATIONS
	CLIPBOARD
}

enum WebsiteType {
	CUSTOM
	HOMEPAGE
	BLOG
	FTP
	HOME
	WORK
	OTHER
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
schema {
	query: Query
	mutation: Mutation
}
