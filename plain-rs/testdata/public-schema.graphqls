"""
Optional device features. A client hides a whole section when its
capability is absent, which is why this is a list rather than a set of
booleans on the app root.
"""
enum Capability {
	MEDIA_TRASH
	MIRROR_AUDIO
	DOC_PREVIEW
	IMAGE_SEARCH
	MEDIA_SCAN
	SMS
	CALLS
	CALL_PHONE
	CONTACTS
	PACKAGES
	NOTES
	FEEDS
	SCREEN_MIRROR
	IMAGE_EDITOR
	NOTIFICATIONS
	CLIPBOARD
	POMODORO
}

