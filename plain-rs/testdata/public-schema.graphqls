type Query {
	appFiles(offset: Int!, limit: Int!, query: String!): [AppFile!]!
	appFileCount(query: String!): Int!
	bookmarks: [Bookmark!]!
	bookmarkGroups: [BookmarkGroup!]!
	pomodoroSettings: PomodoroSettings!
	pomodoroToday: PomodoroToday!
	imageEditorProjects: [ImageEditorProjectSummary!]!
	imageEditorProject(id: ID!): ImageEditorProject
	noteCount(query: String!): Int!
	note(id: ID!): Note
	notes(offset: Int!, limit: Int!, query: String!): [Note!]!
	feedSyncStates: [FeedSyncState!]!
	feed(id: ID!): Feed
	feeds: [Feed!]!
	feedEntryCounts: [FeedEntryCount!]!
	feedEntryCount(query: String!): Int!
	feedEntry(id: ID!): FeedEntry
	feedEntries(offset: Int!, limit: Int!, query: String!): [FeedEntry!]!
	audioCount(query: String!): Int!
	audios(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Audio!]!
	"""
	Null rather than an empty string when the track carries no lyrics:
	"no lyrics file" and "a lyrics file that is empty" are the same
	answer to a client, and only one of them survives the wire.
	"""
	audioLyrics(path: String!): String
	"""
	The active queue, paged. Filtering is on the item title and artist,
	which is the same text a client would show.
	"""
	audioQueueItems(offset: Int!, limit: Int!, query: String!): [AudioItem!]!
	audioQueueItemCount: Int!
	audioPlaylists: [AudioPlaylist!]!
	audioPlaylistItems(id: ID!, offset: Int!, limit: Int!, query: String!): [AudioItem!]!
	audioPlaylistItemCount(id: ID!): Int!
	audioPlayHistory(offset: Int!, limit: Int!, query: String!): [AudioPlayHistory!]!
	"""
	Half of this is a store read (the mode is a user preference, the
	current path is the queue's) and half is the player itself, which is
	platform state Rust cannot see.
	"""
	audioPlayback: AudioPlayback!
	"""
	Latest-first page of one conversation, returned oldest-to-newest so
	clients can render directly. `target` is the chat target id: a bare
	peer id (an optional `peer:` prefix is accepted), or a
	`channel:<id>` prefixed channel id.
	"""
	chatItems(target: String!, offset: Int!, limit: Int!, query: String!): [ChatItem!]!
	"""
	The most recent item of every conversation (direct and channel),
	newest conversation first.
	"""
	latestChatItems: [ChatItem!]!
	chatChannels: [ChatChannel!]!
	peers: [Peer!]!
	"""
	The SIM slots the platform reports. Empty on a device with no
	telephony, which is the honest answer rather than an error.
	"""
	sims: [Sim!]!
	packages(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Package!]!
	packageCount(query: String!): Int!
	packageStatuses(ids: [ID!]!): [PackageStatus!]!
	notifications(offset: Int!, limit: Int!, query: String!): [Notification!]!
	notificationCount(query: String!): Int!
	"""
	Paged clipboard history, newest first.
	"""
	clipboardItems(offset: Int!, limit: Int!, query: String!): [ClipboardItem!]!
	clipboardItemCount(query: String!): Int!
	contacts(offset: Int!, limit: Int!, query: String!): [Contact!]!
	"""
	plain-app degrades this to 0 rather than erroring when the web client
	was not granted the contact permission.
	"""
	contactCount(query: String!): Int!
	contactSources: [ContactSource!]!
	contactGroups: [ContactGroup!]!
	sms(offset: Int!, limit: Int!, query: String!): [Sms!]!
	smsCount(query: String!): Int!
	smsBoxCounts: SmsCounts!
	smsConversations(offset: Int!, limit: Int!, query: String!): [SmsConversation!]!
	smsConversationCount(query: String!): Int!
	archivedSmsConversations(offset: Int!, limit: Int!, query: String!): [SmsConversation!]!
	calls(offset: Int!, limit: Int!, query: String!): [Call!]!
	"""
	plain-app degrades this to 0 rather than erroring.
	"""
	callCount(query: String!): Int!
	isScreenMirroring: Boolean!
	screenMirrorControlEnabled: Boolean!
	"""
	Null while the pipeline has not published its codec configuration.
	"""
	screenMirrorVideoCodec: ScreenMirrorVideoCodec
	screenMirrorQuality: ScreenMirrorQuality!
	imageSearchStatus: ImageSearchStatus!
	"""
	Volumes the platform reports. The host builds these because drive
	enumeration is platform state; there is nothing to gate.
	"""
	mounts: [Mount!]!
	"""
	Recently-opened files. Reading them is a storage read, so this one
	gates — plain-app's `recentFiles` calls `checkEnabledAsync`.
	"""
	recentFiles: [File!]!
	"""
	One page of a directory listing, filtered and sorted by the search
	DSL. `query` may carry a `parent` field to redirect the root, which
	is what the file manager's breadcrumb links send.
	"""
	files(root: String!, offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [File!]!
	"""
	Total matches for the same query, ignoring paging.
	"""
	fileCount(root: String!, query: String!): Int!
	"""
	Stat plus, for media names, the platform's decoder output. A path
	that cannot be resolved is not an error: plain-app reports zeros so
	the info panel renders rather than blowing up on a stale link.
	
	The probe only runs once the stat succeeded — that stat is what the
	file-access authorization rides on, so probing a denied path would
	hand a client metadata for bytes it may not read.
	"""
	fileInfo(path: String!, fileName: String): FileInfo!
	"""
	A total predicate, never an error: a blank path, `"."`, a missing
	file and a denied path all read as `false` so callers can use it in
	a filter without guarding every call.
	"""
	pathExists(path: String!): Boolean!
	"""
	Same total-predicate semantics as `pathExists`; `null` when the path
	cannot be resolved.
	"""
	pathKind(path: String!): PathKind
	"""
	Bookmarked directories. These live in the Rust SQLite
	`favorite_folders` table, so this reads the store directly instead
	of asking the platform to refresh — going through the host would
	re-enter this very root once `main_graphql` serves the public
	schema.
	"""
	favoriteFolders: [FavoriteFolder!]!
	"""
	Folder counts for one library kind. Degrades to empty rather than
	erroring: a client showing the folder strip has nothing useful to do
	with `no_permission`, but an empty strip reads as "no folders yet".
	"""
	mediaBuckets(type: MediaDataType!): [MediaBucket!]!
	imageCount(query: String!): Int!
	images(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Image!]!
	videoCount(query: String!): Int!
	videos(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Video!]!
	docCount(query: String!): Int!
	docs(offset: Int!, limit: Int!, query: String!, sortBy: FileSortBy!): [Doc!]!
	docExtGroups: [DocExtGroup!]!
	tags(type: DataType!): [Tag!]!
	tagRelations(type: DataType!, keys: [String!]!): [TagRelation!]!
	"""
	`null` when the id is unknown — the web client treats that as "gone"
	and drops the tag from its list.
	"""
	tag(id: ID!): Tag
	tagKeys(id: ID!): [String!]!
	userPrefs: JSON!
	systemPrefs: JSON!
	dbPath: String!
	dbTables: [String!]!
	dbTableRowCount(table: String!): Long!
	"""
	Rows come back as pre-rendered JSON strings, one per row — the
	column set differs per table, so there is no single row type to
	model.
	"""
	dbTableRows(table: String!, offset: Int!, limit: Int!): [String!]!
	dbTableColumns(table: String!): [DbTableColumn!]!
	dbTableInfo(table: String!): DbTableInfo!
	"""
	Chunk state for a client-chosen chunk-set id, as `index:byteSize`
	strings. An empty list means the upload never started or was
	discarded — the caller cannot tell, and does not need to.
	"""
	uploadedChunks(fileId: String!): [String!]!
	"""
	`NONE` when no merge was ever started for this id, which is what a
	client sees before it calls `mergeChunks`.
	"""
	mergeStatus(fileId: String!): MergeTask!
	"""
	Battery level is null when the platform cannot report it; CPU and
	storage are not, because a zero there is a real reading.
	"""
	deviceStatus: DeviceStatus!
	deviceInfo: DeviceInfo!
	"""
	Everything a client needs to reach this device: its identity, the
	port it listens on and the token that authorises it.
	"""
	app: App!
	"""
	Log lines, newest first. A blank `query` pages the buffer directly;
	a non-blank one filters the whole buffer and then pages, so a
	search cannot be cut short by the page size.
	"""
	appLogs(offset: Int!, limit: Int!, query: String!): [String!]!
	appLogPath: String!
	"""
	Whether the mDNS advertiser is currently scanning. Starting and
	stopping are commands, not state, so they report success rather
	than a snapshot the caller would have to re-read.
	"""
	isDiscovering: Boolean!
}

enum ScreenMirrorMode {
	HD
	SMOOTH
}

type ScreenMirrorQuality {
	mode: ScreenMirrorMode!
	resolution: Int!
}

type ScreenMirrorVideoCodec {
	"""
	H.264 Annex-B codec configuration (SPS/PPS), base64-encoded.
	"""
	annexB: String!
	"""
	Latest H.264 keyframe, base64-encoded; null until the pipeline emits one.
	"""
	keyFrame: String
}

type Sim {
	id: ID!
	label: String!
	number: String!
	subscriptionId: Int!
}

type Sms {
	id: ID!
	body: String!
	address: String!
	sentAt: Instant!
	serviceCenter: String!
	read: Boolean!
	threadId: ID!
	type: SmsType!
	subscriptionId: Int!
	isMms: Boolean!
	attachments: [SmsAttachment!]!
	tags: [Tag!]!
}

type SmsAttachment {
	path: String!
	contentType: String!
	name: String!
}

type SmsConversation {
	id: ID!
	address: String!
	snippet: String!
	lastMessageAt: Instant!
	messageCount: Int!
	read: Boolean!
	addresses: [String!]!
}

type SmsCounts {
	total: Int!
	inbox: Int!
	sent: Int!
	drafts: Int!
}

enum SmsType {
	INBOX
	SENT
	DRAFT
	OUTBOX
	FAILED
	QUEUED
	UNKNOWN
}

"""
The contract's `Tag` carries no numeric kind — that lives in the
`tags(type:)` filter instead — so it is not `content_types::Tag`.
"""
type Tag {
	id: ID!
	name: String!
	count: Int!
}

"""
One (tag, item-key) relation (plain-app contract). `key` is the media id
/ entity key the tag is attached to.
"""
type TagRelation {
	tagId: ID!
	key: String!
}

input TagRelationStub {
	key: String!
	title: String!
	size: Long!
}

type Temperature {
	label: String!
	celsius: Float!
}

type Video {
	id: ID!
	title: String!
	path: String!
	durationMs: Long!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

type VideoFileInfo {
	width: Int!
	height: Int!
	durationMs: Long!
	location: Location
}

enum WebSettingsFeature {
	FILES
	CONTACTS
	SMS
	CALL_LOGS
	CALL_PHONE
	PHONE_NUMBER
	APPS
	NOTIFICATIONS
	CLIPBOARD
}

enum WebsiteType {
	CUSTOM
	HOMEPAGE
	BLOG
	FTP
	HOME
	WORK
	OTHER
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
schema {
	query: Query
	mutation: Mutation
}
