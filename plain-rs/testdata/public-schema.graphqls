scalar Instant

"""
A scalar that can represent any JSON value.
"""
scalar JSON

"""
The `app` root echoes a write back rather than reading the store again,
so a caller can confirm what it asked for without a round trip.
"""
type KeyValuePair {
	key: String!
	value: String!
}

type Location {
	latitude: Float!
	longitude: Float!
}

scalar Long

type MediaBucket {
	id: ID!
	name: String!
	itemCount: Int!
	topItemPaths: [String!]!
}

"""
The library kind a client is asking about. The names are the contract's,
which is also what the platform's `DataType` enum uses — the mapping is
the identity, so there is nothing to translate.
"""
enum MediaDataType {
	AUDIO
	VIDEO
	IMAGE
	DOC
}

union MediaFileInfo = ImageFileInfo | AudioFileInfo | VideoFileInfo

enum MediaPlayMode {
	REPEAT
	REPEAT_ONE
	SHUFFLE
}

type MergeTask {
	status: MergeTaskStatus!
	value: String
	mergedSize: Long
	error: String
}

enum MergeTaskStatus {
	NONE
	STARTED
	MERGING
	DONE
	FAILED
}

"""
A mounted volume. The phone reports one row per storage the platform
knows about (internal, SD card, each USB disk, the app-private dir);
the fields are all filled by the host, never derived here.
"""
type Mount {
	id: ID!
	name: String!
	path: String!
	mountPoint: String!
	fsType: String!
	totalBytes: Long!
	usedBytes: Long!
	freeBytes: Long!
	remote: Boolean!
	alias: String!
	driveType: DriveType!
	diskId: String!
}

type Mutation {
	addBookmarks(urls: [String!]!, groupId: ID!): [Bookmark!]!
	updateBookmark(id: ID!, input: BookmarkInput!): Bookmark!
	deleteBookmarks(ids: [ID!]!): ActionResult!
	recordBookmarkClick(id: ID!): Boolean!
	createBookmarkGroup(name: String!): BookmarkGroup!
	updateBookmarkGroup(id: ID!, name: String!, collapsed: Boolean!, sortOrder: Int!): BookmarkGroup!
	deleteBookmarkGroup(id: ID!): Boolean!
	startPomodoro(durationSec: Int!): Boolean!
	pausePomodoro: Boolean!
	stopPomodoro: Boolean!
	saveImageEditorProject(id: ID!, input: ImageEditorProjectInput!): ImageEditorProject!
	deleteImageEditorProject(id: ID!): Boolean!
	broadcastImageEditorUpdate(id: ID!, update: String!): Boolean!
	createNote(input: NoteInput!): Note!
	updateNote(id: ID!, input: NoteInput!): Note!
	saveFeedEntriesToNotes(query: String!): [ID!]!
	trashNotes(query: String!): ActionResult!
	restoreNotes(query: String!): ActionResult!
	"""
	A blank query would match every note, and a bulk delete is not
	something a client should be able to aim at the whole library by
	accident — refused before the store is touched.
	"""
	deleteNotes(query: String!): ActionResult!
	exportNotes(query: String!): String!
	updateFeedUrl(id: ID!, url: String!): Feed!
	markFeedEntriesRead(query: String!, read: Boolean!): ActionResult!
	"""
	Starts the sync and returns immediately; the web client watches the
	websocket for `FEEDS_FETCHED` rather than blocking on this call.
	"""
	syncFeeds(id: ID): Boolean!
	updateFeed(id: ID!, name: String!, fetchContent: Boolean!): Feed!
	createFeed(url: String!, fetchContent: Boolean!): Feed!
	importFeeds(content: String!): Boolean!
	exportFeeds: String!
	deleteFeed(id: ID!): Boolean!
	syncFeedEntryContent(id: ID!): FeedEntry!
	"""
	Blank query refused for the same reason as `deleteNotes`: a bulk
	delete must never be aimable at the whole library by accident.
	"""
	deleteFeedEntries(query: String!): ActionResult!
	"""
	Marks the track current without touching the queue, which is what a
	"play this one row" tap means. The metadata comes from the platform
	because the queue stores whatever the file says.
	"""
	playAudio(path: String!): AudioItem!
	updateAudioPlayMode(mode: MediaPlayMode!): Boolean!
	"""
	Clearing the queue is two actions: the rows go, and the player is
	told to stop. Leaving the second to the app would leave a player
	running over an empty queue.
	"""
	clearAudioQueue: Boolean!
	removeAudioFromQueue(path: String!): Boolean!
	"""
	The cap is the same 1000 plain-app uses: this is "queue these", not a
	bulk import, and a client that means everything should page instead.
	"""
	addAudiosToQueue(query: String!): Boolean!
	reorderAudioQueue(paths: [String!]!): Boolean!
	createAudioPlaylist(name: String!): AudioPlaylist!
	updateAudioPlaylist(id: ID!, name: String!): AudioPlaylist!
	deleteAudioPlaylist(id: ID!): Boolean!
	addAudioPlaylistItems(id: ID!, paths: [String!]!): Boolean!
	removeAudioPlaylistItem(id: ID!, path: String!): Boolean!
	"""
	Null when there is nothing to play — an empty playlist, or a start
	path that is no longer in it — rather than an error, because "it
	played nothing" is the honest answer and the caller can show it.
	"""
	playAudioPlaylist(id: ID!, path: String, shuffle: Boolean!): AudioItem
	playAllAudios(shuffle: Boolean!): AudioItem
	"""
	Send a chat message. `target` is the chat target id — a bare peer id
	(an optional `peer:` prefix is accepted), or a `channel:<id>`
	prefixed channel id; same value space as the `chatItems` query.
	`content` is the message envelope JSON, same shape as
	`ChatItem.content`.
	"""
	sendChatItem(target: String!, content: String!): [ChatItem!]!
	"""
	Always true: an id that is already gone is the state the caller asked
	for, and the contract has no way to say "nothing was there".
	"""
	deleteChatItem(id: ID!): Boolean!
	deleteChatItems(query: String!): ActionResult!
	retryChatItem(id: ID!): ChatItem!
	createChatChannel(name: String!): ChatChannel!
	updateChatChannel(id: ID!, name: String!): ChatChannel!
	deleteChatChannel(id: ID!): Boolean!
	leaveChatChannel(id: ID!): Boolean!
	addChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	removeChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	acceptChatChannelInvite(id: ID!): Boolean!
	declineChatChannelInvite(id: ID!): Boolean!
	pairDevice(input: PairingDeviceInput!): Boolean!
	cancelPairing(deviceId: ID!): Boolean!
	respondToPairing(input: PairingRequestInput!, accepted: Boolean!): Boolean!
	deletePeer(id: ID!): Boolean!
	unpairPeer(id: ID!): Boolean!
	uninstallPackages(ids: [ID!]!): Boolean!
	"""
	Bundle unpacking is heavy disk I/O, so the platform side keeps it off
	the engine thread; a failure surfaces as `Installation failed: …`.
	"""
	installPackage(path: String!): PackageInstallPending!
	deleteNotifications(ids: [ID!]!): ActionResult!
	"""
	`actionIndex` indexes [`Notification::reply_actions`], the
	reply-capable subset — not the plain action list.
	"""
	replyNotification(id: ID!, actionIndex: Int!, text: String!): Boolean!
	"""
	Write text into the system clipboard on behalf of the calling client.
	The write is recorded with the caller as source; the local watcher
	sees it but skips re-broadcasting (hash dedup), so there is no loop.
	"""
	setClipboard(text: String!): Boolean!
	"""
	Delete clipboard history entries matching the query DSL (`ids:` /
	`text:`; a bare word is a text LIKE). A blank query is rejected —
	send `all:true` to target everything (API_SPEC §5).
	"""
	deleteClipboardItems(query: String!): ActionResult!
	createContact(input: ContactInput!): Contact!
	updateContact(id: ID!, input: ContactInput!): Contact!
	deleteContacts(query: String!): ActionResult!
	createContactGroup(name: String!, accountName: String!, accountType: String!): ContactGroup!
	updateContactGroup(id: ID!, name: String!): ContactGroup!
	deleteContactGroup(id: ID!): Boolean!
	archiveSmsConversation(id: ID!): Boolean!
	unarchiveSmsConversation(id: ID!): Boolean!
	trashSms(query: String!): ActionResult!
	restoreSms(query: String!): ActionResult!
	deleteSms(query: String!): ActionResult!
	"""
	`subscriptionId` picks the SIM (-1 = system default, see `sims`);
	`requestId` is an optional idempotency key that dedupes retried sends.
	"""
	sendSms(number: String!, body: String!, subscriptionId: Int!, requestId: String): Boolean!
	"""
	Compose an MMS in the device's default SMS app and track the send.
	Returns a pendingId consumed by the MMS polling flow.
	"""
	sendMms(number: String!, body: String!, attachmentPaths: [String!]!, threadId: ID!): String!
	deleteCalls(query: String!): ActionResult!
	"""
	`showDialer` hands the number to the dialer instead of placing the
	call outright.
	"""
	call(number: String!, showDialer: Boolean!): Boolean!
	startScreenMirror(audio: Boolean!): Boolean!
	stopScreenMirror: Boolean!
	"""
	Returns false when the device has not granted RECORD_AUDIO yet; the
	platform asks for it and the caller retries.
	"""
	requestScreenMirrorAudio: Boolean!
	requestScreenMirrorKeyFrame: Boolean!
	updateScreenMirrorQuality(mode: ScreenMirrorMode!): Boolean!
	enableImageSearch: Boolean!
	importImageSearchModel: Boolean!
	disableImageSearch: Boolean!
	cancelImageModelDownload: Boolean!
	"""
	`force` re-scans images that already have an embedding.
	"""
	startImageIndex(force: Boolean): Boolean!
	cancelImageIndex: Boolean!
	openAccessibilitySettings: Boolean!
	openWebSettings(feature: WebSettingsFeature): Boolean!
	"""
	Each mutation returns the whole updated list, so a client never has
	to guess what the operation did to the rows it did not touch.
	"""
	addFavoriteFolder(rootPath: String!, fullPath: String!): [FavoriteFolder!]!
	"""
	An unknown `fullPath` is not an error: the folder was already gone,
	and returning the current list is the honest answer either way.
	"""
	removeFavoriteFolder(fullPath: String!): [FavoriteFolder!]!
	setFavoriteFolderAlias(fullPath: String!, alias: String!): [FavoriteFolder!]!
	createTag(type: DataType!, name: String!): Tag!
	updateTag(id: ID!, name: String!): Tag!
	deleteTag(id: ID!): Boolean!
	"""
	Attaches every tag to every key the query matches. An empty query
	would tag the whole library, so it is rejected before the platform
	ever sees it.
	"""
	addToTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	"""
	Same key resolution as `addToTags`, minus the title and size the
	relation stub carries — removal has nothing to record.
	"""
	removeFromTags(type: DataType!, tagIds: [ID!]!, query: String!): Boolean!
	"""
	One key, an explicit add and remove list. The stub's title and size are
	stored on the relation: the tag editor shows them without a second
	lookup, so dropping them would make a tagged row render blank.
	"""
	updateTagRelations(type: DataType!, item: TagRelationStub!, addTagIds: [ID!]!, removeTagIds: [ID!]!): Boolean!
	setUserPref(key: String!, value: JSON!): Boolean!
	removeUserPref(key: String!): Boolean!
	"""
	`row` is a JSON object of column values. A malformed one is reported
	as `false` rather than an error: this is a developer console, and the
	operator is the one who typed it.
	"""
	createDbTableRow(table: String!, row: String!): Boolean!
	deleteDbTableRows(table: String!, ids: [String!]!): Boolean!
	"""
	Counts what was actually removed. A path that was already gone
	counts as zero, so the number is the delta rather than the request
	size.
	"""
	deleteFiles(paths: [String!]!): ActionResult!
	createDir(path: String!): File!
	"""
	`false` rather than an error when the rename is refused: a name that
	is empty, a traversal segment, or an existing destination are all
	ordinary outcomes for a user typing in a rename box.
	"""
	renameFile(path: String!, name: String!): Boolean!
	writeTextFile(path: String!, content: String!, overwrite: Boolean!): File!
	copyFile(src: String!, dst: String!, overwrite: Boolean!): Boolean!
	moveFile(src: String!, dst: String!, overwrite: Boolean!): Boolean!
	deleteChunks(fileId: String!): Boolean!
	"""
	Starts the merge and returns immediately; completion arrives over the
	websocket, and `mergeStatus` is the polling fallback for a lost event.
	"""
	mergeChunks(fileId: String!, totalChunks: Int!, path: String!, replace: Boolean!, totalSize: Long!): MergeTask!
	mergeAppFileChunks(fileId: String!, totalChunks: Int!, fileName: String!, totalSize: Long!): MergeTask!
	"""
	A blank query would match the whole library, and a bulk delete is
	not something a client should be able to aim at everything by
	accident — it is refused before the platform is asked.
	"""
	deleteMediaItems(type: MediaDataType!, query: String!): ActionResult!
	trashMediaItems(type: MediaDataType!, query: String!): ActionResult!
	restoreMediaItems(type: MediaDataType!, query: String!): ActionResult!
	"""
	The only media action that is also a storage write, so it is the
	only one that gates — the others just move rows between the library
	and the trash.
	"""
	moveMediaItems(type: MediaDataType!, query: String!, destDir: String!): ActionResult!
	clearAppLogs: Boolean!
	setTempValue(key: String!, value: String!): KeyValuePair!
	"""
	The app restarts itself; the response only acknowledges that the
	request was accepted, since the connection dies with the process.
	"""
	relaunchApp: Boolean!
	"""
	Renaming the device also re-publishes the mDNS advertisement, so a
	client that waits for the new name to appear does see it.
	"""
	updateDeviceName(name: String!): Boolean!
	startDiscovery: Boolean!
	stopDiscovery: Boolean!
}

type Note {
	id: ID!
	title: String!
	content: String!
	deletedAt: Instant
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
}

