<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is MANDATORY for Mac App Store distribution.
         Must sign with the App Store ("Mac App Store") cert + a provisioning
         profile that includes the multicast entitlement, or codesign fails. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Read/write access to files/folders the user picks via NSOpenPanel,
         NSSavePanel, or <input type=file>. Capture export writes the PNG
         selected through the native save dialog. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Outgoing TCP/UDP network connections (plain sockets, LAN traffic). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Incoming TCP/UDP connections (local HTTP/WebSocket proxy listener). -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Restricted entitlement: must be granted by Apple and present in the
         App Store provisioning profile. Already approved for this app.
         Required for UDP multicast (mDNS LAN discovery). -->
    <key>com.apple.developer.networking.multicast</key>
    <true/>

    <!-- Optional, add only if the feature grows: bookmarks.app-scope
         (persist access across launches). -->
</dict>
</plist>
